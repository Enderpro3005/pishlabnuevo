# Copia este archivo a .env y ajusta los valores (opcional: si no existe .env, PhishLab usa valores por defecto).

# Puerto del servidor (Railway lo inyecta automaticamente como PORT)
PORT=3000

# Directorio donde se guarda la base de datos JSON y los archivos subidos.
# En Railway: apuntalo al volumen montado, ej: /data
# DATA_DIR=/data

# Tiempo de vida de la sesion en milisegundos (7 dias por defecto)
# SESSION_TTL=604800000

# --- SMTP (opcional: sin configurar, el envio se simula en local) ---
# SMTP_HOST=smtp.tuproveedor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tucorreo@dominio.com
# SMTP_PASS=tupassword
# SMTP_FROM=Seguridad Google <security@tu-dominio.com>

# Secreto de sesion: si no se define, se genera y persiste en data/db.json (meta.sessionSecret)
# SESSION_SECRET=cambia-esto-por-un-secreto-largo
